# Plantilla de configuración local. Copia este archivo como .env o ejecuta
#   ./scripts/configurar-entorno-local.sh
# que crea .env con contraseñas aleatorias. El archivo .env NUNCA se sube a GitHub.

# Contraseña del administrador "sa" del contenedor de SQL Server.
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=

# Contraseña del usuario de la aplicación (taller_app), la que usa Web.config.
TALLER_APP_PASSWORD=

# Puerto local de SQL Server (1434 para no chocar con otros proyectos en 1433).
SQLSERVER_PORT=1434
