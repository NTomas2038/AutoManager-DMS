<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración compartida de AutoManager DMS. Este archivo SÍ se sube a GitHub:
  no contiene credenciales. La cadena de conexión se lee de ConnectionStrings.config,
  que es local y está en .gitignore (plantilla: ConnectionStrings.config.example).
-->
<configuration>
  <connectionStrings configSource="ConnectionStrings.config" />
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <!--
      requestValidationMode="2.0": la validación automática de entradas sigue activa
      en TODAS las páginas por defecto, pero cada página puede desactivarla con
      ValidateRequest="false" (Mono y .NET 4.8 lo respetan en este modo). Las páginas
      de Clientes y de Vehículos lo hacen porque validan en la Capa Lógica y codifican
      todo lo que muestran; así un texto como "<script>" recibe un mensaje claro y no un error 500.
      enableVersionHeader="false": no anuncia la versión de ASP.NET en las respuestas.
    -->
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" enableVersionHeader="false" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" culture="es-GT" uiCulture="es" />
    <!--
      mode="On": un error no controlado o una dirección inexistente muestran Error.html
      también en la propia computadora, nunca el detalle técnico (pila de llamadas, versiones).
      Para ver el detalle mientras se desarrolla: depurador de Visual Studio (F5) o, solo de
      forma local y sin subirlo a GitHub, mode="Off".
    -->
    <customErrors mode="On" defaultRedirect="~/Error.html">
      <error statusCode="404" redirect="~/Error.html" />
    </customErrors>
  </system.web>
</configuration>
